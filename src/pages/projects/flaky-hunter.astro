---
import Case from '../../layouts/Case.astro';

const verdicts = [
  ['Broken', 'Failed the last N executions in a row (default 3). Checked first: a real bug must never be quarantined.', 'c-red'],
  ['Flaky', 'Passed on retry, or passed and failed on the same commit, or flipped pass↔fail at least twice with a score above the threshold.', 'c-warn'],
  ['Insufficient data', 'Fewer than --min-runs executions and no hard evidence yet.', 'c-muted'],
  ['Stable', 'Everything else, including a single isolated infrastructure blip.', 'c-green'],
];

const quickstart = `npm ci && npm run build

# 1. Download the last 30 runs' report artifacts from GitHub Actions
GITHUB_TOKEN=... node dist/cli.js fetch --repo my-org/my-app \\
  --artifact junit-report --limit 30 --out reports

# 2. Analyse
node dist/cli.js analyze reports --title "my-app e2e" \\
  --html out/dashboard.html --markdown out/summary.md \\
  --quarantine out/quarantine.json --fail-on broken`;

const action = `- uses: actions/download-artifact@v4
  with: { pattern: junit-*, path: reports }
- uses: EduardMilitaruG/flaky-hunter@main
  with:
    reports: reports
    title: Nightly e2e
    fail-on: new-flaky,broken
    previous-quarantine: .github/flaky-quarantine.json`;
---

<Case
  title="flaky-hunter"
  category="QA tooling · case study"
  description="flaky-hunter: a TypeScript CLI and GitHub Action that finds, scores and quarantines flaky tests from CI history (JUnit XML and Playwright JSON)."
  lead="<b>Find, score and quarantine flaky tests from your CI history.</b> A test that fails once and then passes on retry looks green on the dashboard, but over time it wears down trust in CI. flaky-hunter reads the reports a pipeline already produces (JUnit XML from Jest, Vitest, pytest or Maven, and Playwright JSON), lines up the last N runs and says which tests are flaky, which are really broken, and which failures share a root cause."
  tags={['TypeScript', 'Node.js', 'Vitest', 'Playwright', 'GitHub Actions', 'JUnit XML']}
  links={[{ label: 'Open the live dashboard ↗', href: '/demos/flaky-hunter/', internal: true }]}
  stats={[
    { value: '84', label: 'Vitest unit tests', tone: 'accent' },
    { value: '99%', label: 'line coverage', tone: 'fill' },
    { value: '16', label: 'Playwright end-to-end tests', tone: 'green' },
    { value: '6', label: 'CI combos: Ubuntu/Windows × Node 20/22/24' },
  ]}
>
  <section class="band"><div class="wrap cs">
    <h2><span class="n">01</span>What it tells you</h2>
    <ul class="facts">
      <li><b>Flaky</b><span>Which tests are non-deterministic, and how badly, with a 0–100 score.</span></li>
      <li><b>Broken</b><span>Which tests are real regressions that should be fixed, not quarantined.</span></li>
      <li><b>Root cause</b><span>Which failures share a cause, by grouping normalised error messages.</span></li>
      <li><b>New flakes</b><span>Whether this PR introduced a new flaky test, so CI can block only on new flakes.</span></li>
    </ul>
  </div></section>

  <section class="band"><div class="wrap cs">
    <h2><span class="n">02</span>How a test is judged</h2>
    <ol class="layers">
      {verdicts.map(([name, rule, tone], i) => (
        <li>
          <span class="ln">{String(i + 1).padStart(2, '0')}</span>
          <h3 class={tone}>{name}</h3>
          <p>{rule}</p>
        </li>
      ))}
    </ol>
    <p style="margin-top:22px"><b>Score</b> = (pass↔fail flips + retry-passes + 2 × same-commit conflicts) ÷ executions, as a percentage. Same-commit conflicts weigh double: the code did not change, so the test itself is non-deterministic.</p>
    <p><b>Failure signatures.</b> Messages are normalised (timings, ports, numbers, UUIDs, hashes, quoted values and file paths removed), so <code>Timeout 5123ms … :8123/v1/intents</code> and <code>Timeout 2410ms … :8999/v1/intents</code> group as one root cause.</p>
  </div></section>

  <section class="band"><div class="wrap cs">
    <h2><span class="n">03</span>Live demo</h2>
    <p>A dashboard generated by flaky-hunter from a simulated 30-run e-shop history.</p>
    <div class="demo-frame ticks">
      <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
      <iframe src={`${import.meta.env.BASE_URL}demos/flaky-hunter/`} title="flaky-hunter demo dashboard" loading="lazy"></iframe>
    </div>
  </div></section>

  <section class="band"><div class="wrap cs">
    <h2><span class="n">04</span>Use it</h2>
    <div class="code-grid">
      <div><span class="comment">CLI</span><pre><code>{quickstart}</code></pre></div>
      <div><span class="comment">GitHub Action</span><pre><code>{action}</code></pre></div>
    </div>
    <p>The Markdown summary goes to the job summary automatically. The project's own CI runs flaky-hunter on its own test results.</p>
  </div></section>
</Case>

<style>
  .demo-frame { margin-top: 18px; border: 1px solid var(--line); background: var(--panel); height: clamp(420px, 70vh, 760px); }
  .demo-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .code-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 18px; }
  .code-grid > div { min-width: 0; }
  .code-grid .comment { display: block; margin-bottom: 8px; }
  @media (width <= 900px) { .code-grid { grid-template-columns: 1fr; } }
</style>
