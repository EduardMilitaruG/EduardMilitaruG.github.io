---
import { t, type Lang } from '../i18n';
import { STACK } from '../data/site';
import TechIcon from './TechIcon.astro';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const groups = Object.entries(STACK) as [keyof typeof STACK, (typeof STACK)[keyof typeof STACK]][];
---

<section class="band" id="stack">
  <div class="wrap section">
    <header class="section-head" data-reveal>
      <span class="section-num">04</span>
      <h2 class="section-title" set:html={d.stack.title} />
      <p class="section-lead">{d.stack.lead}</p>
    </header>

    <div class="stack-grid">
      {groups.map(([key, items], i) => (
        <div class:list={['group', `g-${key}`, key === 'testing' && 'is-main']} data-reveal style={`--d:${i * 0.05}s`}>
          <div class="group-head">
            <span class="comment">{d.stack.groups[key]}</span>
            <span class="num">{String(items.length).padStart(2, '0')}</span>
          </div>
          <ul>
            {items.map((s) => (
              <li title={s.where}>
                <TechIcon name={s.name} size={key === 'testing' ? 20 : 15} />
                <span class="nm">{s.name}</span>
                {key === 'testing' && <span class="where">{s.where}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="source meta" data-reveal>{d.stack.source}</p>
  </div>
</section>

<style>
  .stack-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .group { background: var(--surface); padding: 18px 20px 22px; min-width: 0; }
  .group.is-main { grid-row: span 3; background: linear-gradient(180deg, var(--accent-soft), var(--surface) 45%); }
  .g-ai { grid-column: span 2; }
  .group-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--border); }
  .group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .group li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px; border: 1px solid var(--line); font-size: 13px; color: var(--text); cursor: default; transition: border-color 0.25s var(--ease), color 0.25s var(--ease), background 0.25s var(--ease); }
  .group li :global(.tech-icon:not(.tech-icon--none)) { color: var(--sub); transition: color 0.25s var(--ease); }
  .group li:hover { border-color: var(--accent); color: var(--white); background: var(--hover); }
  .group li:hover :global(.tech-icon:not(.tech-icon--none)) { color: var(--brand, currentColor); }

  .group.is-main ul { flex-direction: column; flex-wrap: nowrap; gap: 0; }
  .group.is-main li { display: grid; grid-template-columns: 20px 1fr; column-gap: 12px; row-gap: 1px; border: 0; border-bottom: 1px dashed var(--border); padding: 7px 4px; background: none; }
  .group.is-main li :global(.tech-icon) { grid-row: span 2; align-self: center; }
  .group.is-main .nm { font-family: var(--f-display); font-weight: 700; font-size: clamp(17px, 0.5vw + 13px, 20px); text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.1; }
  .group.is-main .where { font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.04em; color: var(--muted); line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .group.is-main li:hover { background: none; }
  .group.is-main li:hover .nm { color: var(--accent); }
  .source { margin: 14px 0 0; color: var(--muted); }

  @media (width <= 1024px) {
    .stack-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .group.is-main { grid-row: span 2; }
    .g-ai { grid-column: span 2; }
  }
  @media (width <= 560px) {
    .stack-grid { grid-template-columns: 1fr; }
    .group.is-main { grid-row: auto; }
    .g-ai { grid-column: auto; }
  }
</style>
