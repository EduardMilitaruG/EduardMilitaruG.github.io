---
import Base from './Base.astro';
import { home, url } from '../i18n';

interface Props {
  title: string;
  category: string;
  lead: string;
  tags: string[];
  stats: { value: string; label: string; tone?: 'accent' | 'green' | 'fill' | 'white' }[];
  links?: { label: string; href: string; internal?: boolean }[];
  description: string;
}
const { title, category, lead, tags, stats, links = [], description } = Astro.props;
---

<Base lang="en" title={`${title} · Case study · Eduard Militaru`} description={description} isHome={false}>
  <section class="band case-hero">
    <div class="wrap case-head">
      <a class="back meta" href={`${home('en')}#projects`}>← Back to portfolio</a>
      <span class="comment">{category}</span>
      <h1 class="case-title display">{title}</h1>
      <p class="case-lead" set:html={lead} />
      <ul class="tags">{tags.map((t) => <li class="badge">{t}</li>)}</ul>
      {links.length > 0 && (
        <div class="case-links">
          {links.map((l, i) => (
            <a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-ghost']} href={l.internal ? url(l.href) : l.href} target={l.internal ? undefined : '_blank'} rel={l.internal ? undefined : 'noopener'}>{l.label}</a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="band" aria-label="Key numbers">
    <div class="wrap case-stats" style={`--n:${stats.length}`}>
      {stats.map((s, i) => (
        <div class:list={['cell', s.tone === 'fill' && 'is-fill']}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class:list={['big', 'display', s.tone === 'accent' && 'accent', s.tone === 'green' && 'c-green', (!s.tone || s.tone === 'white') && 'c-white']}>{s.value}</span>
          <span class="meta">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="case-body">
    <slot />
  </div>
</Base>

<style>
  .case-hero { background: radial-gradient(900px 420px at 90% -20%, var(--accent-soft), transparent 70%); }
  .case-head { padding-block: clamp(32px, 5vw, 72px); }
  .back { display: block; width: fit-content; margin-bottom: clamp(24px, 4vw, 48px); color: var(--sub); letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.2s; }
  .back:hover { color: var(--accent); }
  .case-title { margin: 10px 0 18px; font-size: clamp(52px, 8vw + 8px, 136px); color: var(--white); text-wrap: balance; }
  .case-lead { max-width: 68ch; margin: 0 0 22px; color: var(--sub); font-size: var(--t-lead); }
  .case-lead :global(b) { color: var(--white); font-weight: 600; }
  .tags { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .case-links { display: flex; flex-wrap: wrap; gap: 10px; }

  .case-stats { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); padding-inline: 0; }
  .cell { display: flex; flex-direction: column; padding: 18px clamp(14px, 2vw, 24px); border-right: 1px solid var(--border); min-width: 0; }
  .cell:last-child { border-right: 0; }
  .big { font-size: clamp(36px, 3vw + 14px, 58px); margin: 6px 0 4px; }
  .cell.is-fill { background: var(--blue); }
  .cell.is-fill .num, .cell.is-fill .meta { color: rgba(255,255,255,0.65); }
  .cell.is-fill .big { color: #fff; }
  @media (width <= 900px) {
    .case-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cell { border-bottom: 1px solid var(--border); }
    .cell:nth-child(2n) { border-right: 0; }
  }

  /* Shared content styles for the case pages */
  .case-body :global(.cs) { padding-block: clamp(44px, 6vw, 88px); }
  .case-body :global(.cs h2) { margin: 0 0 clamp(18px, 2.4vw, 30px); font-family: var(--f-display); font-weight: 900; text-transform: uppercase; font-size: clamp(34px, 3.4vw + 12px, 60px); line-height: 0.9; color: var(--white); display: flex; gap: 14px; align-items: baseline; }
  .case-body :global(.cs h2 .n) { color: var(--accent); font-size: 0.6em; }
  .case-body :global(.cs p), .case-body :global(.cs li) { color: var(--sub); max-width: 72ch; }
  .case-body :global(.cs b), .case-body :global(.cs strong) { color: var(--white); font-weight: 600; }
  .case-body :global(code) { font-family: var(--f-mono); font-size: 0.92em; color: var(--accent); background: var(--panel); padding: 1px 5px; border: 1px solid var(--border); }
  .case-body :global(pre) { margin: 0; padding: 18px; overflow-x: auto; background: var(--surface); border: 1px solid var(--border); font-family: var(--f-mono); font-size: 13px; line-height: 1.7; color: var(--text); }
  .case-body :global(pre code) { background: none; border: 0; padding: 0; color: inherit; }
  /* Hairlines drawn per tile (not via a gap background) so an odd count never leaves a grey hole */
  .case-body :global(.layers) { list-style: none; margin: 0; padding: 1px 0 0 1px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .case-body :global(.layers li) { background: var(--surface); padding: 18px 20px 20px; max-width: none; border: 1px solid var(--border); margin: -1px 0 0 -1px; }
  .case-body :global(.layers .ln) { font-family: var(--f-display); font-weight: 900; font-size: 34px; color: var(--accent); line-height: 1; }
  .case-body :global(.layers h3) { margin: 8px 0 8px; font-size: 18px; color: var(--white); }
  .case-body :global(.layers p) { margin: 0 0 12px; font-size: 14px; }
  .case-body :global(.tbl-wrap) { overflow-x: auto; border: 1px solid var(--border); }
  .case-body :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 640px; }
  .case-body :global(th) { text-align: left; padding: 10px 14px; font-family: var(--f-mono); font-size: 9.5px; font-weight: 400; letter-spacing: var(--track); text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--border); }
  .case-body :global(td) { padding: 12px 14px; border-top: 1px solid var(--border); color: var(--sub); vertical-align: top; }
  .case-body :global(td:first-child) { font-family: var(--f-display); font-weight: 900; font-size: 20px; color: var(--accent); }
  .case-body :global(tbody tr:hover) { background: var(--hover); }
  .case-body :global(.facts) { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .case-body :global(.facts li) { display: grid; grid-template-columns: 160px 1fr; gap: 16px; padding: 14px 18px; background: var(--surface); max-width: none; }
  .case-body :global(.facts li > b) { font-family: var(--f-mono); font-size: 10px; font-weight: 400; letter-spacing: var(--track); text-transform: uppercase; color: var(--accent); padding-top: 3px; }
  @media (width <= 600px) { .case-body :global(.facts li) { grid-template-columns: 1fr; gap: 4px; } }
</style>
